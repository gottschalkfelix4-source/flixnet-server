<?xml version="1.0"?>
<Container version="2">
  <Name>flixnet</Name>
  <Repository>ghcr.io/gottschalkfelix4-source/flixnet-server:latest</Repository>
  <Registry>https://github.com/gottschalkfelix4-source/flixnet-server/pkgs/container/flixnet-server</Registry>
  <Network>bridge</Network>
  <Privileged>false</Privileged>
  <Support>https://github.com/gottschalkfelix4-source/flixnet-server/issues</Support>
  <Project>https://github.com/gottschalkfelix4-source/flixnet-server</Project>
  <Overview>Flixnet: selbst gehosteter Media Server in Rust mit lokaler KI, Hardware-Transcoding (Intel QuickSync/VAAPI) und Live TV.</Overview>
  <Category>MediaServer:Video MediaServer:Music</Category>
  <WebUI>http://[IP]:[PORT:8097]/</WebUI>
  <Icon>https://raw.githubusercontent.com/gottschalkfelix4-source/flixnet-server/main/web/public/favicon.svg</Icon>
  <ExtraParams>--restart=unless-stopped</ExtraParams>
  <PostArgs/>
  <Config Name="WebUI-Port" Target="8097" Default="8097" Mode="tcp" Description="Web-Oberfläche und API" Type="Port" Display="always" Required="true" Mask="false">8097</Config>
  <Config Name="Config" Target="/config" Default="/mnt/cache/appdata/flixnet" Mode="rw" Description="Datenbank, Bild-Cache, KI-Modelle. Direkt auf dem Cache-Pool (/mnt/cache/...), NICHT /mnt/user, sonst drohen SQLite-Lockfehler." Type="Path" Display="always" Required="true" Mask="false">/mnt/cache/appdata/flixnet</Config>
  <Config Name="Medien" Target="/media" Default="/mnt/user/" Mode="ro" Description="Medienordner (nur lesend)" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/</Config>
  <Config Name="Transcode" Target="/transcode" Default="/tmp/flixnet-transcode" Mode="rw" Description="Temporäre Transcode-Segmente; /tmp liegt im RAM" Type="Path" Display="advanced" Required="false" Mask="false">/tmp/flixnet-transcode</Config>
  <Config Name="Intel/AMD GPU" Target="/dev/dri" Default="/dev/dri" Mode="" Description="Grafik-Device für Hardware-Transcoding (QuickSync/VAAPI)" Type="Device" Display="always" Required="false" Mask="false">/dev/dri</Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="User-ID" Type="Variable" Display="advanced" Required="false" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="Gruppen-ID" Type="Variable" Display="advanced" Required="false" Mask="false">100</Config>
  <Config Name="UMASK" Target="UMASK" Default="022" Mode="" Description="Dateirechte-Maske" Type="Variable" Display="advanced" Required="false" Mask="false">022</Config>
  <Config Name="Log-Level" Target="FLIXNET_LOG__LEVEL" Default="info" Mode="" Description="trace, debug, info, warn, error" Type="Variable" Display="advanced" Required="false" Mask="false">info</Config>
</Container>
