{
  "openapi": "3.1.0",
  "info": {
    "title": "Flixnet API",
    "description": "API of the Flixnet media server. Used by the web UI and future native apps.",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "The Flixnet server serving this document"
    }
  ],
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sign in with name and password.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionDto"
                }
              }
            }
          },
          "401": {
            "description": "Wrong name or password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Invalid device info",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Too many failed attempts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sign out: revokes the token used for this request.",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Signed out"
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/profiles": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Household profiles for the \"Who's watching?\" picker.",
        "operationId": "listProfiles",
        "responses": {
          "200": {
            "description": "Visible profiles",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProfileDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/switch": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Switch this device to another household profile.",
        "description": "Issues a new token for the target profile and revokes the current one.\nProfiles with a PIN need the PIN; administrators without a PIN need their password.",
        "operationId": "switchProfile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SwitchProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Switched; use the new token from now on",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Wrong PIN or password for the target profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "No such visible profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Too many failed attempts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/invitations": {
      "get": {
        "tags": [
          "invitations"
        ],
        "summary": "All invitations (administrators only).",
        "operationId": "listInvitations",
        "responses": {
          "200": {
            "description": "Invitations, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/InvitationDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Not an administrator",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "invitations"
        ],
        "summary": "Create an invitation link (administrators only).",
        "operationId": "createInvitation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInvitationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Invitation created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedInvitationDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Not an administrator",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/invitations/redeem/{code}": {
      "get": {
        "tags": [
          "invitations"
        ],
        "summary": "Is this invitation code still usable?",
        "operationId": "getInvitationStatus",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "description": "Invitation code from the link",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Whether the code can be redeemed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationStatus"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      },
      "post": {
        "tags": [
          "invitations"
        ],
        "summary": "Redeem an invitation: create the own account and sign in.",
        "operationId": "redeemInvitation",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "description": "Invitation code from the link",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Account created and signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionDto"
                }
              }
            }
          },
          "404": {
            "description": "Unknown, expired or used invitation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Name is taken",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/api/v1/invitations/{id}": {
      "delete": {
        "tags": [
          "invitations"
        ],
        "summary": "Withdraw an invitation (administrators only).",
        "operationId": "deleteInvitation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Invitation id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Invitation deleted"
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Not an administrator",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "No such invitation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/setup": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Create the first administrator and sign in.",
        "description": "Only works while no user exists; afterwards it answers 409.",
        "operationId": "completeSetup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Administrator created and signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionDto"
                }
              }
            }
          },
          "409": {
            "description": "Setup was already completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Invalid name, password or device",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/api/v1/setup/status": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Is first-run setup still required?",
        "operationId": "getSetupStatus",
        "responses": {
          "200": {
            "description": "Setup state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupStatus"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/api/v1/system/info": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Get server information.",
        "description": "Public endpoint; needs no authentication.",
        "operationId": "getSystemInfo",
        "responses": {
          "200": {
            "description": "Server information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemInfo"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/api/v1/users": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "All users (administrators only).",
        "operationId": "listUsers",
        "responses": {
          "200": {
            "description": "All users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Not an administrator",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "users"
        ],
        "summary": "Create a user or household profile (administrators only).",
        "operationId": "createUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "User created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Not an administrator",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Name is taken",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/me": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "The signed-in user.",
        "operationId": "getCurrentUser",
        "responses": {
          "200": {
            "description": "The signed-in user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/me/devices": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "Devices signed in to the own account.",
        "operationId": "listMyDevices",
        "responses": {
          "200": {
            "description": "Signed-in devices, most recent first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DeviceDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/me/devices/{id}": {
      "delete": {
        "tags": [
          "users"
        ],
        "summary": "Sign out one of the own devices.",
        "operationId": "signOutDevice",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Device id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Device signed out"
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "No such signed-in device",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/me/password": {
      "put": {
        "tags": [
          "users"
        ],
        "summary": "Change the own password. Signs out all other devices.",
        "operationId": "changePassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Password changed"
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Wrong current password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "New password too short",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Too many failed attempts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/me/pin": {
      "put": {
        "tags": [
          "users"
        ],
        "summary": "Set or remove the own profile PIN.",
        "operationId": "setPin",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetPinRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "PIN updated"
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "PIN is not 4–8 digits",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/{id}": {
      "delete": {
        "tags": [
          "users"
        ],
        "summary": "Delete a user (administrators only; not yourself).",
        "operationId": "deleteUser",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "User id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "User deleted"
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Not an administrator",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "No such user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Cannot delete yourself",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "users"
        ],
        "summary": "Change a user (administrators only).",
        "operationId": "updateUser",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "User id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Updated user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Not an administrator",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "No such user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Name taken, or the last administrator would be lost",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChangePasswordRequest": {
        "type": "object",
        "required": [
          "current_password",
          "new_password"
        ],
        "properties": {
          "current_password": {
            "type": "string"
          },
          "new_password": {
            "type": "string"
          }
        }
      },
      "CreateInvitationRequest": {
        "type": "object",
        "properties": {
          "max_age_rating": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Age limit applied to the new account."
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "description": "Free text, e.g. who the invitation is for."
          },
          "valid_days": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Days until the link expires (1–30, default 7)."
          }
        }
      },
      "CreateUserRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "is_admin": {
            "type": "boolean"
          },
          "is_hidden": {
            "type": "boolean"
          },
          "max_age_rating": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "password": {
            "type": [
              "string",
              "null"
            ],
            "description": "Omit for a profile that cannot sign in remotely (only reachable by switching)."
          },
          "pin": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "CreatedInvitationDto": {
        "type": "object",
        "required": [
          "invitation",
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "The secret code; shown once. The web UI link is `/invite/{code}`."
          },
          "invitation": {
            "$ref": "#/components/schemas/InvitationDto"
          }
        }
      },
      "Credentials": {
        "type": "object",
        "required": [
          "name",
          "password",
          "device"
        ],
        "properties": {
          "device": {
            "$ref": "#/components/schemas/DeviceInfo"
          },
          "name": {
            "type": "string",
            "example": "Felix"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "DeviceDto": {
        "type": "object",
        "required": [
          "id",
          "name",
          "client",
          "created_at",
          "last_seen",
          "is_current"
        ],
        "properties": {
          "client": {
            "type": "string"
          },
          "created_at": {
            "type": "integer",
            "format": "int64"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "is_current": {
            "type": "boolean",
            "description": "The device making this request."
          },
          "last_seen": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "DeviceInfo": {
        "type": "object",
        "description": "The client installation that is signing in.",
        "required": [
          "id",
          "name",
          "client"
        ],
        "properties": {
          "client": {
            "type": "string",
            "description": "Client application.",
            "example": "Flixnet Web"
          },
          "id": {
            "type": "string",
            "description": "Stable id generated and stored by the client (e.g. a UUID).",
            "example": "6f1c2a6e-4c1d-4a8e-9a57-0d7f4f1b2c3d"
          },
          "name": {
            "type": "string",
            "description": "Human-readable device name.",
            "example": "Chrome · Windows"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "Error body returned by every failing API call.",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable, machine-readable error code (snake_case).",
            "example": "unauthorized"
          },
          "message": {
            "type": "string",
            "description": "Human-readable description (German, shown to users).",
            "example": "Anmeldung erforderlich."
          }
        }
      },
      "InvitationDto": {
        "type": "object",
        "required": [
          "id",
          "created_at",
          "expires_at"
        ],
        "properties": {
          "created_at": {
            "type": "integer",
            "format": "int64"
          },
          "expires_at": {
            "type": "integer",
            "format": "int64"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "max_age_rating": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "used_at": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "used_by": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          }
        }
      },
      "InvitationStatus": {
        "type": "object",
        "required": [
          "valid"
        ],
        "properties": {
          "valid": {
            "type": "boolean"
          }
        }
      },
      "ProfileDto": {
        "type": "object",
        "required": [
          "id",
          "name",
          "is_admin",
          "unlock",
          "is_current"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "is_admin": {
            "type": "boolean"
          },
          "is_current": {
            "type": "boolean",
            "description": "The profile currently signed in on this device."
          },
          "name": {
            "type": "string"
          },
          "unlock": {
            "$ref": "#/components/schemas/Unlock"
          }
        }
      },
      "SessionDto": {
        "type": "object",
        "description": "A newly issued device token plus the signed-in user.",
        "required": [
          "token",
          "user"
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "Send as `Authorization: Bearer <token>`. Valid until logout or re-login on this device."
          },
          "user": {
            "$ref": "#/components/schemas/UserDto"
          }
        }
      },
      "SetPinRequest": {
        "type": "object",
        "properties": {
          "pin": {
            "type": [
              "string",
              "null"
            ],
            "description": "4–8 digits, or `null` to remove the PIN."
          }
        }
      },
      "SetupStatus": {
        "type": "object",
        "required": [
          "setup_required"
        ],
        "properties": {
          "setup_required": {
            "type": "boolean",
            "description": "`true` until the first administrator account has been created."
          }
        }
      },
      "SwitchProfileRequest": {
        "type": "object",
        "required": [
          "user_id",
          "device"
        ],
        "properties": {
          "device": {
            "$ref": "#/components/schemas/DeviceInfo"
          },
          "password": {
            "type": [
              "string",
              "null"
            ],
            "description": "Required when the profile's `unlock` is `password`."
          },
          "pin": {
            "type": [
              "string",
              "null"
            ],
            "description": "Required when the profile's `unlock` is `pin`."
          },
          "user_id": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "SystemInfo": {
        "type": "object",
        "description": "Public server information used by clients to discover and identify the server.",
        "required": [
          "name",
          "version",
          "api_version",
          "os",
          "arch"
        ],
        "properties": {
          "api_version": {
            "type": "string",
            "description": "API version that the routes are served under.",
            "example": "v1"
          },
          "arch": {
            "type": "string",
            "description": "CPU architecture.",
            "example": "x86_64"
          },
          "name": {
            "type": "string",
            "description": "Product name, always `Flixnet`.",
            "example": "Flixnet"
          },
          "os": {
            "type": "string",
            "description": "Operating system the server runs on.",
            "example": "linux"
          },
          "version": {
            "type": "string",
            "description": "Server version.",
            "example": "0.1.0"
          }
        }
      },
      "Unlock": {
        "type": "string",
        "description": "What switching to a profile requires.",
        "enum": [
          "none",
          "pin",
          "password"
        ]
      },
      "UpdateUserRequest": {
        "type": "object",
        "description": "Every field is optional; `null` clears nullable fields (password, PIN, age limit).",
        "properties": {
          "is_admin": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "is_hidden": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "max_age_rating": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "password": {
            "type": [
              "string",
              "null"
            ],
            "description": "Setting or clearing the password signs the user out everywhere."
          },
          "pin": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "UserDto": {
        "type": "object",
        "required": [
          "id",
          "name",
          "is_admin",
          "is_hidden",
          "has_password",
          "has_pin"
        ],
        "properties": {
          "has_password": {
            "type": "boolean",
            "description": "Can sign in with a password (profiles without one are reachable by switching only)."
          },
          "has_pin": {
            "type": "boolean",
            "description": "Profile switching to this user requires a PIN."
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "is_admin": {
            "type": "boolean"
          },
          "is_hidden": {
            "type": "boolean",
            "description": "Hidden users do not appear in the profile picker."
          },
          "max_age_rating": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Content age limit; `null` = unrestricted."
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "api_key": {
        "type": "apiKey",
        "in": "query",
        "name": "api_key",
        "description": "Device token as query parameter, for URLs that cannot carry headers (media, images)."
      },
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "bearer": []
    },
    {
      "api_key": []
    }
  ],
  "tags": [
    {
      "name": "system",
      "description": "Server information"
    },
    {
      "name": "auth",
      "description": "First-run setup, sign-in, sign-out and profile switching"
    },
    {
      "name": "users",
      "description": "User accounts and household profiles"
    },
    {
      "name": "invitations",
      "description": "Invitation links for new accounts"
    }
  ]
