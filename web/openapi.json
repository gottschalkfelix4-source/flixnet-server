{
  "openapi": "3.1.0",
  "info": {
    "title": "Flixnet API",
    "description": "API of the Flixnet media server. Used by the web UI and future native apps.",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "The Flixnet server serving this document"
    }
  ],
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sign in with name and password.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionDto"
                }
              }
            }
          },
          "401": {
            "description": "Wrong name or password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Invalid device info",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sign out: revokes the token used for this request.",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Signed out"
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/setup": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Create the first administrator and sign in.",
        "description": "Only works while no user exists; afterwards it answers 409.",
        "operationId": "completeSetup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Administrator created and signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionDto"
                }
              }
            }
          },
          "409": {
            "description": "Setup was already completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Invalid name, password or device",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/api/v1/setup/status": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Is first-run setup still required?",
        "operationId": "getSetupStatus",
        "responses": {
          "200": {
            "description": "Setup state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupStatus"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/api/v1/system/info": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Get server information.",
        "description": "Public endpoint; needs no authentication.",
        "operationId": "getSystemInfo",
        "responses": {
          "200": {
            "description": "Server information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemInfo"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/api/v1/users/me": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "The signed-in user.",
        "operationId": "getCurrentUser",
        "responses": {
          "200": {
            "description": "The signed-in user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Credentials": {
        "type": "object",
        "required": [
          "name",
          "password",
          "device"
        ],
        "properties": {
          "device": {
            "$ref": "#/components/schemas/DeviceInfo"
          },
          "name": {
            "type": "string",
            "example": "Felix"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "DeviceInfo": {
        "type": "object",
        "description": "The client installation that is signing in.",
        "required": [
          "id",
          "name",
          "client"
        ],
        "properties": {
          "client": {
            "type": "string",
            "description": "Client application.",
            "example": "Flixnet Web"
          },
          "id": {
            "type": "string",
            "description": "Stable id generated and stored by the client (e.g. a UUID).",
            "example": "6f1c2a6e-4c1d-4a8e-9a57-0d7f4f1b2c3d"
          },
          "name": {
            "type": "string",
            "description": "Human-readable device name.",
            "example": "Chrome Â· Windows"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "Error body returned by every failing API call.",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable, machine-readable error code (snake_case).",
            "example": "unauthorized"
          },
          "message": {
            "type": "string",
            "description": "Human-readable description (German, shown to users).",
            "example": "Anmeldung erforderlich."
          }
        }
      },
      "SessionDto": {
        "type": "object",
        "description": "A newly issued device token plus the signed-in user.",
        "required": [
          "token",
          "user"
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "Send as `Authorization: Bearer <token>`. Valid until logout or re-login on this device."
          },
          "user": {
            "$ref": "#/components/schemas/UserDto"
          }
        }
      },
      "SetupStatus": {
        "type": "object",
        "required": [
          "setup_required"
        ],
        "properties": {
          "setup_required": {
            "type": "boolean",
            "description": "`true` until the first administrator account has been created."
          }
        }
      },
      "SystemInfo": {
        "type": "object",
        "description": "Public server information used by clients to discover and identify the server.",
        "required": [
          "name",
          "version",
          "api_version",
          "os",
          "arch"
        ],
        "properties": {
          "api_version": {
            "type": "string",
            "description": "API version that the routes are served under.",
            "example": "v1"
          },
          "arch": {
            "type": "string",
            "description": "CPU architecture.",
            "example": "x86_64"
          },
          "name": {
            "type": "string",
            "description": "Product name, always `Flixnet`.",
            "example": "Flixnet"
          },
          "os": {
            "type": "string",
            "description": "Operating system the server runs on.",
            "example": "linux"
          },
          "version": {
            "type": "string",
            "description": "Server version.",
            "example": "0.1.0"
          }
        }
      },
      "UserDto": {
        "type": "object",
        "required": [
          "id",
          "name",
          "is_admin"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "is_admin": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "api_key": {
        "type": "apiKey",
        "in": "query",
        "name": "api_key",
        "description": "Device token as query parameter, for URLs that cannot carry headers (media, images)."
      },
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "bearer": []
    },
    {
      "api_key": []
    }
  ],
  "tags": [
    {
      "name": "system",
      "description": "Server information"
    },
    {
      "name": "auth",
      "description": "First-run setup, sign-in and sign-out"
    },
    {
      "name": "users",
      "description": "User accounts"
    }
  ]
}
